@page
@model VideoGameManager.Pages.Games.DeleteModel

<h2>Esborrar Videojoc</h2>

<h3 class="text-danger">Are you sure you want to delete this game?</h3>
<div>
    <h4>@Model.Game!.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Gènere</dt>
        <dd class="col-sm-10">@Model.Game.Genre</dd>

        <dt class="col-sm-2">Any</dt>
        <dd class="col-sm-10">@Model.Game.Year</dd>

        <dt class="col-sm-2">Puntuació</dt>
        <dd class="col-sm-10">@Model.Game.Score</dd>
    </dl>

    <form method="post">
        <input type="hidden" name="id" value="@Model.Game.Id" />

        <button type="submit" class="btn btn-danger">Yes, delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>