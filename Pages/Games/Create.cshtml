@page
@model VideoGameManager.Pages.Games.CreateModel

<h2>Add New Game</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Game.Title" class="control-label">Title</label>
                <input asp-for="Game.Title" class="form-control" />
                <span asp-validation-for="Game.Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Game.Genre" class="control-label">Genre</label>
                <input asp-for="Game.Genre" class="form-control" />
                <span asp-validation-for="Game.Genre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Game.Year" class="control-label">Year</label>
                <input asp-for="Game.Year" class="form-control" />
                <span asp-validation-for="Game.Year" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Game.Score" class="control-label">Score (0-10)</label>
                <input asp-for="Game.Score" class="form-control" />
                <span asp-validation-for="Game.Score" class="text-danger"></span>
            </div>

            <div class="card mb-3 border-primary bg-light">
                <div class="card-header bg-primary text-white">Developer Information</div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="Game.DeveloperId" class="control-label"><strong>Option A:</strong> Select Existing</label>
                        <select asp-for="Game.DeveloperId" asp-items="Model.DeveloperList" class="form-control">
                            <option value="">-- Choose Developer --</option>
                        </select>
                    </div>

                    <div class="text-center my-3"><span class="badge bg-secondary">OR</span></div>

                    <div class="form-group">
                        <label class="control-label"><strong>Option B:</strong> Create New Developer</label>
                        <div class="row g-2">
                            <div class="col-md-12 mb-2">
                                <input asp-for="NewDeveloperName" class="form-control" placeholder="Name of the studio" />
                            </div>
                            <div class="col-md-6">
                                <input asp-for="NewDeveloperCountry" class="form-control" placeholder="Country" />
                            </div>
                            <div class="col-md-6">
                                <input asp-for="NewDeveloperFoundedYear" class="form-control" placeholder="Founded Year" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Game.Description" class="control-label">Description</label>
                <textarea asp-for="Game.Description" class="form-control"></textarea>
                <span asp-validation-for="Game.Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Add Game</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>