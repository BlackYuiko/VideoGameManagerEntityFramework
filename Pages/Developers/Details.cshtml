@page "{id:int}"
@model VideoGameManager.Pages.Developers.DetailsModel
@{
    ViewData["Title"] = Model.Developer?.Name ?? "Details";
}

<div>
    <h2>@Model.Developer!.Name</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Developer.Id</dd>

        <dt class="col-sm-2">Country</dt>
        <dd class="col-sm-10">@Model.Developer.Country</dd>

        <dt class="col-sm-2">Foundation year</dt>
        <dd class="col-sm-10">@Model.Developer.FoundedYear</dd>

        <dt class="col-sm-2">Games Library</dt>
        @if (Model.Developer?.Games != null && Model.Developer.Games.Any())
        {
            <dt class="col-sm-2">
                @foreach (var game in Model.Developer.Games)
                {
                    @game.Title
                        
                }
            </dt>
        }
        else
        {
            <p> No games registered for this developer.</p>
        }
    </dl>
</div>
<div>
    <a asp-page="./Index" class="btn btn-secondary">Come Back</a>
</div>
