@page "{id:int}"
@model VideoGameManager.Pages.Developers.DeleteModel
@{
    ViewData["Title"] = $"Delete {Model.Developer?.Name}";
    bool hasGames = Model.Developer?.Games != null && Model.Developer.Games.Any();
}

<h2>Esborrar Developer</h2>

<h3 class="text-danger">Are you sure you want to delete this game?</h3>
<div>
    <h4>@Model.Developer!.Name</h4>
    <hr />
    @if (hasGames)
    {
        <div style="background-color: #fdf2f2; border-left: 4px solid #e74c3c; padding: 15px; margin-bottom: 20px;">
            <p style="color: #c0392b; margin: 0; font-size: 14px; font-weight: bold;">
                Cannot delete this developer.
            </p>
            <p style="color: #444; margin: 5px 0 0 0; font-size: 13px;">
                This developer is still linked to <strong>@Model.Developer.Games.Count()</strong> games.
                Please delete or reassign the games first.
            </p>
        </div>
    }

    <dl class="row">
        <dt class="col-sm-2">Country</dt>
        <dd class="col-sm-10">@Model.Developer.Country</dd>

        <dt class="col-sm-2">Foundation year</dt>
        <dd class="col-sm-10">@Model.Developer.FoundedYear</dd>

    </dl>

    <form method="post">
        <input type="hidden" name="id" value="@Model.Developer.Id" />
        @if (hasGames)
            {
            <button type="button" class="btn btn-danger" cursor: not-allowed;>Yes, delete</button>
            }
            else
            {
                <button type="submit" class="btn btn-danger">Yes, delete</button>
            }
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>